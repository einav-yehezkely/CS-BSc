    class Avatar
    class Energy
    interface MovementState
    class IdleState
    class RunState
    class JumpState
}

package "pepse.world.trees" {
    class Flora
}

/'PepseGameManager --> Sky'/
/'PepseGameManager --> Terrain'/
/'PepseGameManager --> Night'/
/'PepseGameManager --> Sun'/
/'PepseGameManager --> SunHalo'/
/'PepseGameManager --> Avatar'/
/'PepseGameManager --> Flora'/

/'Terrain --> NoiseGenerator'/
/'Flora ..> Terrain : via callback'/
/'SunHalo --> Sun'/

@enduml


@startuml
package "pepse.world.avatar" {
    class Avatar
    class Energy
    interface MovementState
    class StateFactory
    class IdleState
    class RunState
    class JumpState
}


MovementState -o Avatar

IdleState ...|> MovementState : implementation
RunState ...|> MovementState
JumpState ...|> MovementState
IdleState -o StateFactory : composition
RunState -o StateFactory
JumpState -o StateFactory
Energy -o Avatar

Avatar ...> StateFactory : dependency


@enduml
